<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>seamlineage</AssemblyName>
    <RootNamespace>Seamlineage.Cli</RootNamespace>
    <Description>The shared Seamlineage CLI: reads a graph.manifest.json from any implementation language and writes or checks GRAPH.md and a page per stage.</Description>

    <!-- dotnet tool: dotnet pack, then dotnet tool install seamlineage -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>seamlineage</ToolCommandName>
    <PackageId>Seamlineage.Cli</PackageId>
  </PropertyGroup>

  <!-- Single-file binary for teams without .NET: dotnet publish -r linux-x64 (or win-x64, osx-arm64, ...) self-contained. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seamlineage.Docs\Seamlineage.Docs.csproj" />
  </ItemGroup>

</Project>
